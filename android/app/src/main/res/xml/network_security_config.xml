<?xml version="1.0" encoding="utf-8"?>
<!--
  The stream relay (see the relay/ directory) is served over plain HTTP, so we
  permit cleartext to that host only. Everything else (metadata endpoints,
  artwork) uses https:// and stays encrypted.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">micro.oort.se</domain>
    </domain-config>
</network-security-config>
