<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (http) is needed for two local-network purposes:
    * just_audio's request-header proxy on 127.0.0.1, and
    * UPnP/DLNA control of speakers (Sonos, WiiM) on the LAN, which use http.
  All remote traffic (the stream + metadata) uses https:// URLs and stays
  encrypted regardless of this setting.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
